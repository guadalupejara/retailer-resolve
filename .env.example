# Copy to .env locally, or paste these into Vercel → Project → Settings → Environment Variables.
# Values come from your Lovable Cloud backend (Lovable editor → Project Settings → Backend).

# --- Client (build-time, exposed to the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Server (runtime, used by TanStack server functions) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- AI (server only; never VITE_-prefixed) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
